+// Windows ÉwÉbÉ_Å[ ÉtÉ@ÉCÉã:
+#include <windows.h>
+#include <commdlg.h>
+#include <commctrl.h>
+
+// C ÉâÉìÉ^ÉCÉÄ ÉwÉbÉ_Å[ ÉtÉ@ÉCÉã
+#include <stdio.h>
