diff -urN src_o/makefile.wt src_j/makefile.wt
--- src_o/makefile.wt	Thu Jan 01 09:00:00 1970
+++ src_j/makefile.wt	Sat Feb 19 06:47:40 2005
@@ -0,0 +1,92 @@
+###################################################################
+#
+#  makefile.win - Crawl makefile for Borland C++ 5.5 (Win32)
+#   -- Copied from Hengband makefile.bcc
+###################################################################
+
+!include makefile.obj
+#OBJECTS += libwin.o libwt.o libtile.o tiles.o winclass-win.o winclass.o
+###################################################################
+#
+#       Borland specific directives ---
+#
+.AUTODEPEND
+
+###################################################################
+#
+# Set tool and version names:
+
+CPP        = bcc32
+LINKER     = ilink32
+RC         = brc32
+
+###################################################################
+#
+# Name of the *.exe-file
+
+EXE_FILE = crawl.exe
+
+
+###################################################################
+#
+# Debug mode (un-comment for debugging)
+
+# DBGOPT= -v -N -x -xp
+
+
+###################################################################
+#
+#  Change these for English version (or Japanese version)
+#
+
+# Japanese version (comment out for English version)
+JP_OPT= -DJP
+CRAWL_RC = crawl.rc
+
+###################################################################
+#
+# Set any compiler options
+#-Od -jb -j1 -Hc -tW -lGn -e$(EXE_FILE) -w- \
+
+CCOPTS = -O2 -4 -a -k- -Oc -OS -Oi -Ov -H- -P -e$(EXE_FILE) \
+    -DWINDOWS -D_WIN32_WINNT=0x0400 -DWINVER=0x0400 \
+    -DNEED_SPRINTF -DUSE_ASCII_CHARACTERS -DUSE_COLOUR_OPTS \
+    -DUSE_TILE -DV_FIX
+
+
+# Compile flags:
+CPPFLAGS= $(CCOPTS) $(DBGOPT)
+
+
+######################## Targets ##################################
+
+all : $(EXE_FILE)
+
+clean:
+	-@if exist *.o del *.o >nul
+	-@if exist *.exe del *.exe >nul
+	-@if exist *.res del *.res >nul
+	-@if exist *.tds del *.tds >nul
+	-@if exist *.ilc del *.ilc >nul
+	-@if exist *.ild del *.ild >nul
+	-@if exist *.ilf del *.ilf >nul
+	-@if exist *.ils del *.ils >nul
+
+install: 
+
+########################### Explicit Rules ########################
+$(EXE_FILE): $(OBJECTS) libwt.o libtile.o  tiles.o winclass-win.o winclass.o crawl.res
+	$(LINKER) -aa -x $(OBJECTS) libwt.o libtile.o  tiles.o winclass-win.o winclass.o c0w32.obj, $(EXE_FILE),, cw32.lib import32.lib,, crawl.res
+
+crawl.res: $(CRAWL_RC)
+	$(RC) -r -focrawl.res $(CRAWL_RC)
+
+########################### Implicit Rules ########################
+.cc.o:
+        $(CPP) $(CPPFLAGS) -c  -o$*.o $< 
+
+.c.i:
+	$(CPP) $(CPPFLAGS) -c -Sr -Sd {$? }
+
+#.o.exe:
+#	$(CPP) $(CPPFLAGS) $<
diff -urN src_o/makefile.x11 src_j/makefile.x11
--- src_o/makefile.x11	Thu Jan 01 09:00:00 1970
+++ src_j/makefile.x11	Fri Dec 23 17:20:13 2005
@@ -0,0 +1,481 @@
+# -*- Makefile -*- for Dungeon Crawl (linux x11)
+
+#APPNAME = crawl
+GAME = crawl
+
+# this file contains a list of the libraries.
+# it will make a variable called OBJECTS that contains all the libraries
+include makefile.obj
+
+OBJECTS += tiles.o libx11.o libx11_png.o libtile.o winclass.o winclass-x11.o
+
+# CXX = /usr/local/bin/g++
+CXX = g++
+DELETE = rm -f
+COPY = cp
+OS_TYPE = LINUX
+EXTRA_FLAGS = -DV_FIX -DWIZARD -DUSE_TILE -DUSE_X11
+
+# For Mac OSX
+#EXTRA_FLAGS = -DV_FIX -DWIZARD -DUSE_TILE -DUSE_X11 -DX_LOCALE
+
+CFLAGS = -Wall -Wwrite-strings -Wstrict-prototypes \
+            -Wmissing-prototypes \
+            -O -D$(OS_TYPE) $(EXTRA_FLAGS)
+
+# LDFLAGS = -static
+MCHMOD = 2755
+# INSTALLDIR = /usr/games
+INSTALLDIR = /opt/crawl/bin
+
+LIB = -L/usr/X11R6/lib -lX11 -lpng
+# for MAC OSX
+#LIB = -L/usr/X11R6/lib -lX11 `libpng-config --libs`
+
+# Include for Linux
+INCLUDES = -I/usr/include/ncurses
+
+all: $(GAME)
+
+install: $(GAME)
+	$(COPY) $(GAME) ${INSTALLDIR}
+	chmod ${MCHMOD} ${INSTALLDIR}/$(GAME)
+
+clean:
+	$(DELETE) *.o
+
+distclean:
+	$(DELETE) *.o
+	$(DELETE) bones.*
+	$(DELETE) morgue.txt
+	$(DELETE) scores
+	$(DELETE) $(GAME)
+	$(DELETE) *.sav
+	$(DELETE) core
+	$(DELETE) *.0*
+	$(DELETE) *.lab
+
+
+$(GAME): $(OBJECTS)
+	${CXX} ${LDFLAGS} $(INCLUDES) $(CFLAGS) $(OBJECTS) -o $(GAME) $(LIB)
+	chmod ${MCHMOD} $(GAME)
+
+debug: $(OBJECTS)
+	${CXX} ${LDFLAGS} $(INCLUDES) $(CFLAGS) $(OBJECTS) -o $(GAME) $(LIB)
+
+profile:	$(OBJECTS)
+	${CXX} -g -p ${LDFLAGS} $(INCLUDES) $(CFLAGS) $(OBJECTS) -o $(GAME) $(LIB)
+
+.cc.o:
+	${CXX} ${CFLAGS} -c $< ${INCLUDE}
+
+.h.cc:
+	touch $@
+
+# DO NOT DELETE
+
+abl-show.o: AppHdr.h libutil.h abl-show.h
+abl-show.o: externs.h
+abl-show.o: defines.h enum.h
+abl-show.o: FixAry.h FixVec.h debug.h message.h beam.h effects.h food.h
+abl-show.o: it_use2.h macro.h misc.h monplace.h player.h religion.h skills.h
+abl-show.o: skills2.h spl-cast.h spl-util.h direct.h spells1.h spells2.h
+abl-show.o: spells3.h spells4.h stuff.h transfor.h view.h liblinux.h
+abyss.o: AppHdr.h libutil.h abyss.h
+abyss.o: externs.h
+abyss.o: defines.h enum.h FixAry.h FixVec.h
+abyss.o: debug.h
+abyss.o: message.h cloud.h monplace.h dungeon.h items.h lev-pand.h randart.h
+abyss.o: stuff.h
+acr.o: AppHdr.h libutil.h
+acr.o: externs.h defines.h enum.h FixAry.h FixVec.h
+acr.o: debug.h message.h abl-show.h abyss.h chardump.h command.h delay.h
+acr.o: describe.h direct.h dungeon.h effects.h fight.h files.h food.h
+acr.o: hiscores.h initfile.h invent.h item_use.h it_use2.h it_use3.h
+acr.o: itemname.h items.h lev-pand.h macro.h misc.h monplace.h monstuff.h
+acr.o: mon-util.h mutation.h newgame.h ouch.h output.h overmap.h player.h
+acr.o: randart.h religion.h shopping.h skills.h skills2.h spells1.h spells3.h
+acr.o: spells4.h spl-book.h spl-cast.h spl-util.h stuff.h tags.h transfor.h
+acr.o: view.h wpn-misc.h
