+#ifdef JP
+unsigned char* itosym1(int stat)
+{
+    return (unsigned char*)( (stat >= 1) ? "°€" : "°§" );
+}
+
+unsigned char* itosym3(int stat)
+{
+    return (unsigned char*)( (stat >= 3) ? "°€°€°€" :
+             (stat == 2) ? "°€°€°§" :
+             (stat == 1) ? "°€°§°§" :
+             (stat == 0) ? "°§°§°§" :
+                           "X°§°§");
+}
+#else
+unsigned char* itosym1(int stat)
+{
+    return (unsigned char*)( (stat >= 1) ? "+ " : ".  " );
+}
+
+unsigned char* itosym3(int stat)
+{
+    return (unsigned char*)( (stat >= 3) ? "+ + +" :
+             (stat == 2) ? "+ + ." :
+             (stat == 1) ? "+ . ." :
+             (stat == 0) ? ". . ." :
+                           "X . .");
+}
+#endif
+
