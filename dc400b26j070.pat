+int prompt_for_int( const char *prompt, bool nonneg )
+{
+    char specs[80];
+
+    mpr( prompt, MSGCH_PROMPT );
+#ifdef USE_TILE
+    mpr_on(MODE_MPR);
+    get_input_line( specs, sizeof( specs ) );
+    mpr_on(MODE_CRT);
+#else
+    get_input_line( specs, sizeof( specs ) );
+#endif
+    if (specs[0] == '\0')
+        return (nonneg ? -1 : 0);
+
+    char *end;
+    int   ret = strtol( specs, &end, 10 );
+
+    if ((ret < 0 && nonneg) || (ret == 0 && end == specs))
+        ret = (nonneg ? -1 : 0);
+
+    return (ret);
+}
+
+
