+//---------------------------------------------------------------
+//
+// getstr for win32console
+//
+//---------------------------------------------------------------
+void w32c_get_input_line(char* buffer, int bufferSize)
+{
+    ASSERT(buffer != NULL);
+    ASSERT(bufferSize > 1);
+
+    int index = 0;
+    int ccx = cx+1;
+    int ccy = cy+1;
+
+    while (index < bufferSize - 1)
+    {
+        char ch;
+        ch = getch();
+
+        if (ch == '\r' && index >= 0)
+            break;
+        else if (ch == 0x08 && index > 0)
+            {
+                --index;
+                buffer[index] = '\0';
+                gotoxy(ccx,ccy);
+                cprintf( "%s ", buffer );
+                gotoxy(ccx + index,ccy);
+            }
+        else if (isprint(ch))
+            {
+                buffer[index++] = ch;
+                buffer[index] = '\0';
+                gotoxy(ccx,ccy);
+                cprintf( "%s ", buffer );
+                gotoxy(ccx + index, ccy);
+            }
+    }
+
+    buffer[index] = '\0';
 }
