+        case LIGHTMAGENTA:
+                return "pandem3";
+
+        case GREEN:
+        case LIGHTGREEN:
+                return "pandem4";
+
+        case CYAN:
+        case LIGHTCYAN:
+        case WHITE:
+                return "lapis";
+
+        case BROWN:
+        case YELLOW:
