+void MapRegionClass::init_backbuf()
+{
+    int i;
+
+//É~ÉjÉ}ÉbÉvópÉpÉåÉbÉgÇÃçÏê¨
+    BYTE black;
+    RGBQUAD scol[16] = {
+    {  0,   0,   0, 0},
+    {255,  82,   0, 0},
+    { 70, 185, 100, 0},
+    {180, 180,   0, 0},//!!!
+    {  0,  48, 255, 0},
+    {238,  92, 238, 0},
+    {  0,  91, 165, 0},
+    {162, 162, 162, 0},
+    { 82,  82,  82, 0},
+    {255, 102,  82, 0},
+    { 82, 255,  82, 0},
+    {255, 255,  82, 0},
+    { 82,  82, 255, 0},
+    {255,  82, 255, 0},
+    { 82, 255, 255, 0},
