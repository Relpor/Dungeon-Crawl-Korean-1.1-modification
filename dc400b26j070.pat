diff -urN src_o/libx11.cc src_j/libx11.cc
--- src_o/libx11.cc	Thu Jan 01 09:00:00 1970
+++ src_j/libx11.cc	Tue Dec 13 20:48:28 2005
@@ -0,0 +1,1032 @@
+/*
