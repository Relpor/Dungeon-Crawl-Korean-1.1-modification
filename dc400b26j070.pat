-// realize that this is simply a repackaged version of
-// stuff::see_grid() -- make certain they correlate {dlb}:
-bool mons_near(struct monsters *monster, unsigned int foe)
-{
-    // early out -- no foe!
-    if (foe == MHITNOT)
-        return (false);
+#ifdef DOS_TERM
+        puttext(2, 1, 34, 17, buffy.buffer());
+#endif
 
-    if (foe == MHITYOU)
-    {
-        if (monster->x > you.x_pos - 9 && monster->x < you.x_pos + 9
-            && monster->y > you.y_pos - 9 && monster->y < you.y_pos + 9)
+#ifdef PLAIN_TERM
         {
-            if (env.show[monster->x - you.x_pos + 9][monster->y - you.y_pos + 9])
-                return (true);
-        }
-        return (false);
-    }
 
-    // must be a monster
-    struct monsters *myFoe = &menv[foe];
-    if (myFoe->type >= 0)
-    {
-        if (monster->x > myFoe->x - 9 && monster->x < myFoe->x + 9
-            && monster->y > myFoe->y - 9 && monster->y < myFoe->y + 9)
+        gotoxy(2, 1);
+        bufcount = 0;
+
+        // this line is purely optional
+        if (you.running == 0 ||
+            ((Options.travel_delay > -1) && (you.run_x !=0 || you.run_y !=0)))
         {
-            return (true);
+#ifdef USE_TILE
+            extern void display_gmap();
+            display_gmap();
+#endif
+            for (count_x = 0; count_x < 1120; count_x += 2)     // 1056
+            {
+  #ifdef JP
+              if (Options.use_zenkaku)
+              {
+                if ((count_x % 66) >=16 && (count_x % 66)<=50)
+                {
+                    unsigned char ch=buffy[count_x];
+
+                    if(ch < 32) ch = 32;
+
+                    if (Options.use_cake)
+                    {
+                        if (ch == 127 || ch == 137 || ch == 138 || ch == 139 || ch == 140)
+                            textcolor_cake( buffy[count_x + 1] );
+                        else if ( (ch == '*') && ( buffy[count_x + 1] == DARKGREY ) )
+                            textcolor_cake(BLUE);
+                        else
+                            textcolor(buffy[count_x + 1]);
+                    }
+                    else
+                        textcolor(buffy[count_x + 1]);
+                    writeWChar( &ascii_to_zenkaku[(ch-' ')*2] );
+                }
+              }
+              else //zenkaku
+  #endif
+              {
+                unsigned char ch = buffy[count_x];
+
+                if (Options.use_cake)
+                {
+                  if (ch == 127 || ch == 137 || ch == 138 || ch == 139 || ch == 140)
+                      textcolor_cake( buffy[count_x + 1] );
+                  else if ( (ch == '*') && ( buffy[count_x + 1] == DARKGREY ) )
+                      textcolor_cake(BLUE);
+                  else
+                      textcolor(buffy[count_x + 1]);
+                }
+                else
+                    textcolor(buffy[count_x + 1]);
+
+                if(ch >= 127) ch = special_to_ascii[ch - 127];
+                putch(ch);
+              }
+  #if defined(LINUX) && !defined(USE_X11)
+              textbackground(BLACK);
+  #endif
+
+              if (count_x % 66 == 64 && count_x > 0)
+                  gotoxy(2, wherey() + 1);
+            }
         }
     }
+#endif //PLAIN_TERM
 
-    return (false);
-}                               // end mons_near()
+        _setcursortype(_NORMALCURSOR);
 
+    }                           // end of (if brek...)
+}                               // end viewwindow3()
 
