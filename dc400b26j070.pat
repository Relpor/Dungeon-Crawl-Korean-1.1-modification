 static void hiscore_newline( char *buf, int &line_count ) 
 {
+#ifdef JP 
+    strncat( buf, EOL "             ", HIGHSCORE_SIZE );
+#else
     strncat( buf, EOL "             ", HIGHSCORE_SIZE );
