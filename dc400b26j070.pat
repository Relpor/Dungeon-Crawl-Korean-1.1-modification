+
+#endif //USE_TILE
+
+/*
+ * Global variables
+ */
+/* X11 */ Display *display=NULL;
+/* X11 */ int screen;
+/* X11 */ GC xgc[MAX_PIX_COLOR];
+
+WinClass *win_main = NULL;
+
+TextRegionClass *region_crt = NULL;
+TextRegionClass *region_msg = NULL;
+TextRegionClass *region_stat = NULL;
+MapRegionClass  *region_map = NULL;
