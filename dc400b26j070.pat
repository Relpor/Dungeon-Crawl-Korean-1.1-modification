+    snprintf(CUR_AD, "µ∂º“ ≥ªº∫ : %s\0", itosym1( player_res_poison(calc_unid) ) );
+    //snprintf(CUR_AD, " /%2d", player_res_poison() );
+    snprintf(CUR_AD, "¿¸±‚ ≥ªº∫ : %s\0", itosym1( player_res_electricity(calc_unid) ) );
+    //snprintf(CUR_AD, " /%2d", player_res_electricity() );
