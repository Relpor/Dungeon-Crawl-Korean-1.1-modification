+#ifdef JP
+void get_full_detail(char* buffer, bool calc_unid)
+{
+#define FIR_AD buffer,44
+#define CUR_AD &buffer[++lines*45],44
+#define BUF_SIZE 25*3*45
+    int lines =0, i = 0, j = 0;
+    char str_pass[ITEMNAME_SIZE];
+
+    for(i=0; i < BUF_SIZE; i++)
+        buffer[i] = '\0';
+
+    snprintf(CUR_AD, "%s°∏%s°π\0", player_title(), you.your_name);
+    lines++;
+    snprintf(CUR_AD, "¡æ¡∑     : %s\0", species_name(you.species,you.experience_level) );
+    snprintf(CUR_AD, "¡˜æ˜     : %s\0", you.class_name);
+    snprintf(CUR_AD, "Ω≈æ”     : %s\0", god_name(you.religion) );
+    snprintf(CUR_AD, "\0");
+    snprintf(CUR_AD, "∑π∫ß        %7d\0", you.experience_level);
+    snprintf(CUR_AD, "∞Ê«Ëƒ°      %7d\0", you.experience);
+
+    if (you.experience_level < 27)
+    {
+        int xp_needed = (exp_needed(you.experience_level+2) - you.experience) + 1;
+        snprintf(CUR_AD, "∞Ê«Ëƒ° ∏Ò«• %7d\0", exp_needed(you.experience_level + 2) + 1);
+        snprintf(CUR_AD, "« ø‰ ∞Ê«Ëƒ° %7d\0", xp_needed);
+    }
+    else
+    {
+        snprintf(CUR_AD, "¥Ÿ¿Ω ∑π∫ß   *******\0");
+        snprintf(CUR_AD, "« ø‰ ∞Ê«Ëƒ° *******\0");
+    }
+
+    snprintf(CUR_AD, "≥≤¿∫ ∏∂π˝   %7d\0", player_spell_levels() );
+
+    snprintf(CUR_AD, "º“¡ˆ±›      %7d\0", you.gold );
+
+    lines++;
+/*
+    snprintf(str_pass, ITEMNAME_SIZE, "%s\0",
+             ( (you.hp > 0)       ? "":
+               (you.deaths_door)  ? " (∫ÛªÁ)":
+                                    " (ªÁ∏¡)" ) );
+*/
+    if ( (you.hp_max + player_rotted() ) == you.hp_max )
+    {
+        snprintf(CUR_AD, "HP     : %3d/%3d\0",
+                 you.hp, you.hp_max);
+    }
+    else
+    {
+        snprintf(CUR_AD, "HP     : %3d/%3d (%3d)\0",
+                 you.hp, you.hp_max,
+                 you.hp_max + player_rotted() );
+    }
+
+    snprintf(CUR_AD, "MP     : %3d/%3d\0", you.magic_points, you.max_magic_points);
+
+    if (you.strength == you.max_strength)
+    {
+        snprintf(CUR_AD, "»˚     : %3d\0", you.strength);
+    }
+    else
+    {
+        snprintf(CUR_AD, "»˚     : %3d (%2d)\0", you.strength, you.max_strength);
+    }
+
+    if (you.intel == you.max_intel)
+    {
+        snprintf(CUR_AD, "¡ˆ¥…   : %3d\0", you.intel);
+    }
+    else
+    {
+        snprintf(CUR_AD, "¡ˆ¥…   : %3d (%2d)\0", you.intel, you.max_intel);
+    }
+
+    if (you.dex == you.max_dex)
+    {
+        snprintf(CUR_AD, "πŒ√∏   : %3d\0", you.dex);
+    }
+    else
+    {
+        snprintf(CUR_AD, "πŒ√∏   : %3d (%2d)\0", you.dex, you.max_dex);
+    }
+
+    snprintf(CUR_AD, "AC     : %3d\0", player_AC() );
+    snprintf(CUR_AD, "»∏««   : %3d\0", player_evasion() );
+    snprintf(CUR_AD, "πÊ∆–   : %3d\0", player_shield_class() );
+    lines++;
+
+    if (you.real_time != -1)
+    {
+        const time_t curr = you.real_time + (time(NULL) - you.start_time);
+        char buff[200];
+        make_time_string( curr, buff, sizeof(buff) );
+
+        snprintf(CUR_AD, "∞‘¿”Ω√∞£ : %10s\0", buff);
+        snprintf(CUR_AD, "∞Ê∞˙ ≈œ  : %10d\0", you.num_turns );
+    }
+
+    lines = 27;
+
+    snprintf(CUR_AD, "»≠ø∞ ≥ªº∫ : %s\0", itosym3( player_res_fire(calc_unid) ) );
+    //snprintf(CUR_AD, " /%2d", player_res_fire() );
+    snprintf(CUR_AD, "≥√±‚ ≥ªº∫ : %s\0", itosym3( player_res_cold(calc_unid) ) );
+    //snprintf(CUR_AD, " /%2d", player_res_cold() );
+    snprintf(CUR_AD, "æ‡»≠ ≥ªº∫ : %s\0", itosym3( player_prot_life(calc_unid) ) );
