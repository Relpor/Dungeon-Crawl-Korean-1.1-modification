+
+        case BRANCH_TARTARUS:
+        case BRANCH_CRYPT:
+            return "crypt";
+
+        case BRANCH_TOMB:
+            return "pyramid";
+
+    case BRANCH_MAIN_DUNGEON:
+            return "rock";
+
+    case BRANCH_DIS:
+        case BRANCH_HALL_OF_BLADES:
